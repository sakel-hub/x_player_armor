msgid "Tip: Right-click in hand to quick-equip or swap"
msgstr "Tip: Kliknite pravým tlačidlom v ruke pre rýchle nasadenie/výmenu"

msgid "Tip: Equip in shield slot; hold RMB to raise guard"
msgstr "Tip: Vložte do slotu štítu; držte pravé tlačidlo pre krytie"

msgid "Tip: Equip in shield slot; hold RMB to raise heavy guard"
msgstr "Tip: Vložte do slotu štítu; držte pravé tlačidlo pre ťažké krytie"

msgid "Tip: Point crosshair at stand to view equipped pieces"
msgstr "Tip: Namierte zameriavač na stojan pre zobrazenie nasadených kusov"

