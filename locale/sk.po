msgstr "@1 použití"

msgid "✦ Healing Ward: +@1% Chance on hit to nullify damage & heal"
msgstr "✦ Liečivý štít: +@1% šanca pri zásahu na zrušenie zranenia a liečenie"

msgid "✦ Fire Ward: +1 Heat Tier (Tier 5 Molten Immunity at 4+ pieces)"
msgstr "✦ Ohňový štít: +1 úroveň tepla (Úroveň 5 - imunita na lávu pri 4+ kusoch)"

msgid "✦ Fire Ward: +1 Heat Tier (Protects against torches & hot flora)"
msgstr "✦ Ohňový štít: +1 úroveň tepla (Chráni pred fakľami a horúcou flórou)"

msgid "✦ Water Ward: Underwater Breathing (Infinite Drown Immunity)"
msgstr "✦ Vodný štít: Dýchanie pod vodou (Nekonečná imunita voči utopeniu)"

msgid "✦ Feather Fall: -@1 Fall Damage (@2 Hearts Absorbed)"
msgstr "✦ Pierkový pád: -@1 poškodenie z pádu (@2 srdiečka pohltené)"

msgid "✦ Shield Guard (Hold RMB):"
msgstr "✦ Krytie štítom (Držte pravé tlačidlo):"

msgid "✦ Reinforced Tower Guard (Hold RMB):"
msgstr "✦ Zosilnené krytie vežovým štítom (Držte pravé tlačidlo):"

msgid "  • Block Mitigation: @1% damage absorbed"
msgstr "  • Zníženie blokovaním: @1% poškodenia pohltené"

msgid "  • Block Mitigation: @1% damage absorbed (reinforced)"
msgstr "  • Zníženie blokovaním: @1% poškodenia pohltené (zosilnené)"

msgid "  • Frontal Guard Arc: @1° cone (@2° off-hand bias)"
msgstr "  • Predný uhol krytia: @1° kužeľ (@2° vychýlenie doľava)"

msgid "  • Projectile Deflection: Bounces arrows & fireballs"
msgstr "  • Odrazenie projektilov: Odrazí šípy a ohnivé gule"

msgid "  • Thorns: Damages melee attacker's weapon"
msgstr "  • Tŕne: Poškodzuje zbraň útočníka"

msgid "✦ Thorns: Damages melee attacker's weapon"
msgstr "✦ Tŕne: Poškodzuje zbraň útočníka"

msgid "✦ Swiftness: @1% Movement Speed"
msgstr "✦ Rýchlosť: @1% rýchlosť pohybu"

msgid "✦ High Jump: @1% Jump Height"
msgstr "✦ Vysoký skok: @1% výška skoku"

msgid "✦ Gravity: @1%"
msgstr "✦ Gravitácia: @1%"

msgid "★ Set Synergy (4+ Pieces): +10% Total Defense"
msgstr "★ Synergia setu (4+ kusy): +10% celková obrana"

msgid "★ Tower Shield: Counts toward matching 4-piece set bonus"
msgstr "★ Vežový štít: Počíta sa do bonusu 4-dielneho setu"

msgid "  Combine 4 wood pieces for early-game defense bonus."
msgstr "  Kombinujte 4 drevené kusy pre počiatočný bonus obrany."

msgid "  Combine 4 cactus pieces for early-game thorny protection."
msgstr "  Kombinujte 4 kaktusové kusy pre počiatočnú tŕnistú ochranu."

msgid "  Combine 4 steel pieces for solid all-around mid-game defense."
msgstr "  Kombinujte 4 oceľové kusy pre spoľahlivú celkovú obranu."

msgid "  Combine 4 bronze pieces for heavy durable defense exceeding steel."
msgstr "  Kombinujte 4 bronzové kusy pre ťažkú odolnú obranu prevyšujúcu oceľ."

msgid "  Combine 4 diamond pieces for elite end-game damage absorption."
msgstr "  Kombinujte 4 diamantové kusy pre elitné pohlcovanie poškodenia."

msgid "  Full set yields +12% (+15% w/ shield) healing ward chance!"
msgstr "  Celý set dáva +12% (+15% so štítom) šancu na liečivý štít!"

msgid "  Combine set for high durability, healing ward & feather falling!"
msgstr "  Kombinujte set pre vysokú trvácnosť, liečivý štít a pierkový pád!"

msgid "  Hybrid Set: Water breathing (head), fire ward (chest) & healing (shield)!"
msgstr "  Hybridný set: Dýchanie pod vodou (hlava), ohňový štít (hruď) a liečenie (štít)!"

msgid "  Full 4+ piece set grants Tier 5 Molten & Lava Immunity!"
msgstr "  Plný set 4+ kusov dáva 5. úroveň imunity voči láve a ohňu!"

msgid "★ Omnipotent Set: Total immunity, infinite durability & 100% healing ward."
msgstr "★ Všemocný set: Úplná imunita, nekonečná trvácnosť a 100% liečivý štít."

msgid "✦ Wardrobe Management & Quick Swap:"
msgstr "✦ Správa šatníka & rýchla výmena:"

msgid "  • Live 3D character display mannequin"
msgstr "  • Živá 3D figurína postavy"

msgid "  • Right-click: Open Stand UI with one-click Swap button"
msgstr "  • Pravé kliknutie: Otvorenie rozhrania stojana s tlačidlom Výmena"

msgid "  • Sneak + Right-click: Instant quick-swap loadout"
msgstr "  • Prikrčenie + pravé kliknutie: Okamžitá rýchla výmena výbavy"

msgid "  • Preserves item wear, enchants, and custom metadata"
msgstr "  • Zachováva opotrebenie, očarovania a vlastné metadáta"

