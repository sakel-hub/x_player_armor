msgid "@1 Uses"
msgstr "@1 Utilisations"

msgid "✦ Healing Ward: +@1% Chance on hit to nullify damage & heal"
msgstr "✦ Protection guérisseuse: +@1% de chance d'annuler les dégâts et soigner"

msgid "✦ Fire Ward: +1 Heat Tier (Tier 5 Molten Immunity at 4+ pieces)"
msgstr "✦ Protection de feu: +1 niveau de chaleur (Niveau 5 immunité lave avec 4+ pièces)"

msgid "✦ Fire Ward: +1 Heat Tier (Protects against torches & hot flora)"
msgstr "✦ Protection de feu: +1 niveau de chaleur (Protège des torches et flore brûlante)"

msgid "✦ Water Ward: Underwater Breathing (Infinite Drown Immunity)"
msgstr "✦ Protection d'eau: Respiration sous l'eau (Immunité infinie à la noyade)"

msgid "✦ Feather Fall: -@1 Fall Damage (@2 Hearts Absorbed)"
msgstr "✦ Chute amortie: -@1 dégâts de chute (@2 cœurs absorbés)"

msgid "✦ Shield Guard (Hold RMB):"
msgstr "✦ Garde au bouclier (Maintenir clic droit):"

msgid "✦ Reinforced Tower Guard (Hold RMB):"
msgstr "✦ Garde au pavois renforcée (Maintenir clic droit):"

msgid "  • Block Mitigation: @1% damage absorbed"
msgstr "  • Atténuation du blocage: @1% des dégâts absorbés"

msgid "  • Block Mitigation: @1% damage absorbed (reinforced)"
msgstr "  • Atténuation du blocage: @1% des dégâts absorbés (renforcé)"

msgid "  • Frontal Guard Arc: @1° cone (@2° off-hand bias)"
msgstr "  • Arc de garde frontal: cône de @1° (décalage de @2° à gauche)"

msgid "  • Projectile Deflection: Bounces arrows & fireballs"
msgstr "  • Déviation de projectiles: Fait rebondir flèches et boules de feu"

msgid "  • Thorns: Damages melee attacker's weapon"
msgstr "  • Épines: Endommage l'arme de l'attaquant au corps à corps"

msgid "✦ Thorns: Damages melee attacker's weapon"
msgstr "✦ Épines: Endommage l'arme de l'attaquant au corps à corps"

msgid "✦ Swiftness: @1% Movement Speed"
msgstr "✦ Vitesse: @1% Vitesse de déplacement"

msgid "✦ High Jump: @1% Jump Height"
msgstr "✦ Grand saut: @1% Hauteur de saut"

msgid "✦ Gravity: @1%"
msgstr "✦ Gravité: @1%"

msgid "★ Set Synergy (4+ Pieces): +10% Total Defense"
msgstr "★ Synergie d'ensemble (4+ pièces): +10% Défense totale"

msgid "★ Tower Shield: Counts toward matching 4-piece set bonus"
msgstr "★ Pavois: Compte pour le bonus d'ensemble de 4 pièces"

msgid "  Combine 4 wood pieces for early-game defense bonus."
msgstr "  Combinez 4 pièces en bois pour un bonus défensif de début de partie."

msgid "  Combine 4 cactus pieces for early-game thorny protection."
msgstr "  Combinez 4 pièces en cactus pour une protection épineuse initiale."

msgid "  Combine 4 steel pieces for solid all-around mid-game defense."
msgstr "  Combinez 4 pièces en acier pour une défense équilibrée en milieu de partie."

msgid "  Combine 4 bronze pieces for heavy durable defense exceeding steel."
msgstr "  Combinez 4 pièces en bronze pour une protection lourde surpassant l'acier."

msgid "  Combine 4 diamond pieces for elite end-game damage absorption."
msgstr "  Combinez 4 pièces en diamant pour une absorption de dégâts d'élite."

msgid "  Full set yields +12% (+15% w/ shield) healing ward chance!"
msgstr "  L'ensemble complet confère +12% (+15% avec bouclier) de chance de soin!"

msgid "  Combine set for high durability, healing ward & feather falling!"
msgstr "  Combinez l'ensemble pour une grande durabilité, soin et chute amortie!"

msgid "  Hybrid Set: Water breathing (head), fire ward (chest) & healing (shield)!"
msgstr "  Ensemble hybride: respiration aquatique (tête), feu (torse) et soin (bouclier)!"

msgid "  Full 4+ piece set grants Tier 5 Molten & Lava Immunity!"
msgstr "  L'ensemble de 4+ pièces confère une immunité de niveau 5 à la lave et au feu!"

msgid "★ Omnipotent Set: Total immunity, infinite durability & 100% healing ward."
msgstr "★ Ensemble omnipotent: Immunité totale, durabilité infinie et 100% de soin."

msgid "✦ Wardrobe Management & Quick Swap:"
msgstr "✦ Gestion de garde-robe & Échange rapide:"

msgid "  • Live 3D character display mannequin"
msgstr "  • Mannequin de présentation 3D du personnage en direct"

msgid "  • Right-click: Open Stand UI with one-click Swap button"
msgstr "  • Clic droit: Ouvrir l'interface du mannequin avec bouton Échanger"

msgid "  • Sneak + Right-click: Instant quick-swap loadout"
msgstr "  • Furtif + Clic droit: Échange rapide instantané de la tenue"

msgid "  • Preserves item wear, enchants, and custom metadata"
msgstr "  • Préserve usure, enchantements et métadonnées personnalisées"

msgid "Armor Stand (Owned by @1)\nEquipped: @2"
msgstr "Mannequin d'armure (Propriétaire: @1)\nÉquipé: @2"

msgid "Armor Stand (Owned by @1) [Empty]"
msgstr "Mannequin d'armure (Propriétaire: @1) [Vide]"

msgid "Armor Stand\nEquipped: @1"
msgstr "Mannequin d'armure\nÉquipé: @1"

msgid "Armor Stand [Empty]"
msgstr "Mannequin d'armure [Vide]"

msgid "Tip: Right-click in hand to quick-equip or swap"
msgstr "Astuce: Clic droit en main pour équiper ou échanger rapidement"

msgid "Tip: Equip in shield slot; hold RMB to raise guard"
msgstr "Astuce: Équipez en main secondaire; maintenez clic droit pour bloquer"

msgid "Tip: Equip in shield slot; hold RMB to raise heavy guard"
msgstr "Astuce: Équipez en main secondaire; maintenez clic droit pour garde lourde"

msgid "Tip: Point crosshair at stand to view equipped pieces"
msgstr "Astuce: Pointez le réticule vers le mannequin pour voir les pièces équipées"

msgid "Helmet Slot"
msgstr "Emplacement de casque"

msgid "Equip a helmet or headpiece here for defense."
msgstr "Équipez un casque ou une protection de tête ici pour la défense."

msgid "Chestplate Slot"
msgstr "Emplacement de plastron"

msgid "Equip a chestplate or body armor here for core protection."
msgstr "Équipez un plastron ou une armure corporelle ici pour la protection."

msgid "Shield Slot"
msgstr "Emplacement de bouclier"

msgid "Equip a shield here for active frontal damage blocking."
msgstr "Équipez un bouclier ici pour bloquer activement les dégâts frontaux."

msgid "Leggings Slot"
msgstr "Emplacement de jambières"

msgid "Equip leggings or greaves here for lower-body defense."
msgstr "Équipez des jambières ou grèves ici pour la défense du bas du corps."

msgid "Boots Slot"
msgstr "Emplacement de bottes"

msgid "Equip boots here for foot protection and mobility."
msgstr "Équipez des bottes ici pour la protection des pieds et la mobilité."

msgid "Accessory Slot"
msgstr "Emplacement d'accessoire"

msgid "Equip extra armor or an accessory here."
msgstr "Équipez une armure supplémentaire ou un accessoire ici."

msgid "Place a helmet or headpiece here."
msgstr "Placez un casque ou une protection de tête ici."

msgid "Place a chestplate or cuirass here."
msgstr "Placez un plastron ou une cuirasse ici."

msgid "Place a shield here."
msgstr "Placez un bouclier ici."

msgid "Place leggings or greaves here."
msgstr "Placez des jambières ou grèves ici."

msgid "Place boots here."
msgstr "Placez des bottes ici."

