msgid "Tip: Right-click in hand to quick-equip or swap"
msgstr "Consejo: Clic derecho en mano para equipar o cambiar rápidamente"

msgid "Tip: Equip in shield slot; hold RMB to raise guard"
msgstr "Consejo: Equipa en el espacio de escudo; mantén clic derecho para bloquear"

msgid "Tip: Equip in shield slot; hold RMB to raise heavy guard"
msgstr "Consejo: Equipa en el espacio de escudo; mantén clic derecho para guardia pesada"

msgid "Tip: Point crosshair at stand to view equipped pieces"
msgstr "Consejo: Apunta la mira al soporte para ver las piezas equipadas"

msgid "Helmet Slot"
msgstr "Espacio de casco"

msgid "Equip a helmet or headpiece here for defense."
msgstr "Equipa un casco o protector de cabeza aquí para defensa."

msgid "Chestplate Slot"
msgstr "Espacio de peto"

msgid "Equip a chestplate or body armor here for core protection."
msgstr "Equipa un peto o armadura corporal aquí para protección central."

msgid "Shield Slot"
msgstr "Espacio de escudo"

msgid "Equip a shield here for active frontal damage blocking."
msgstr "Equipa un escudo aquí para bloqueo activo frontal."

msgid "Leggings Slot"
msgstr "Espacio de grebas"

msgid "Equip leggings or greaves here for lower-body defense."
msgstr "Equipa grebas o pantalones aquí para defensa inferior."

msgid "Boots Slot"
msgstr "Espacio de botas"

msgid "Equip boots here for foot protection and mobility."
msgstr "Equipa botas aquí para protección de pies y movilidad."

msgid "Accessory Slot"
msgstr "Espacio de accesorio"

msgid "Equip extra armor or an accessory here."
msgstr "Equipa armadura adicional o un accesorio aquí."

msgid "Place a helmet or headpiece here."
msgstr "Coloca un casco o protector de cabeza aquí."

msgid "Place a chestplate or cuirass here."
msgstr "Coloca un peto o coraza aquí."

msgid "Place a shield here."
msgstr "Coloca un escudo aquí."

msgid "Place leggings or greaves here."
msgstr "Coloca grebas o pantalones aquí."

msgid "Place boots here."
msgstr "Coloca botas aquí."

