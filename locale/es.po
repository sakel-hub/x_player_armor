msgstr "@1 Usos"

msgid "✦ Healing Ward: +@1% Chance on hit to nullify damage & heal"
msgstr "✦ Guardia sanadora: +@1% probabilidad al recibir golpe de anular daño y curar"

msgid "✦ Fire Ward: +1 Heat Tier (Tier 5 Molten Immunity at 4+ pieces)"
msgstr "✦ Guardia de fuego: +1 nivel de calor (Nivel 5 inmunidad a lava con 4+ piezas)"

msgid "✦ Fire Ward: +1 Heat Tier (Protects against torches & hot flora)"
msgstr "✦ Guardia de fuego: +1 nivel de calor (Protege contra antorchas y flora ardiente)"

msgid "✦ Water Ward: Underwater Breathing (Infinite Drown Immunity)"
msgstr "✦ Guardia de agua: Respiración bajo el agua (Inmunidad infinita al ahogamiento)"

msgid "✦ Feather Fall: -@1 Fall Damage (@2 Hearts Absorbed)"
msgstr "✦ Caída de pluma: -@1 daño por caída (@2 corazones absorbidos)"

msgid "✦ Shield Guard (Hold RMB):"
msgstr "✦ Guardia con escudo (Mantener clic derecho):"

msgid "✦ Reinforced Tower Guard (Hold RMB):"
msgstr "✦ Guardia con escudo torre reforzada (Mantener clic derecho):"

msgid "  • Block Mitigation: @1% damage absorbed"
msgstr "  • Mitigación de bloqueo: @1% daño absorbido"

msgid "  • Block Mitigation: @1% damage absorbed (reinforced)"
msgstr "  • Mitigación de bloqueo: @1% daño absorbido (reforzado)"

msgid "  • Frontal Guard Arc: @1° cone (@2° off-hand bias)"
msgstr "  • Arco frontal de guardia: cono de @1° (@2° desvío hacia la izquierda)"

msgid "  • Projectile Deflection: Bounces arrows & fireballs"
msgstr "  • Desvío de proyectiles: Rebota flechas y bolas de fuego"

msgid "  • Thorns: Damages melee attacker's weapon"
msgstr "  • Espinas: Daña el arma del atacante cuerpo a cuerpo"

msgid "✦ Thorns: Damages melee attacker's weapon"
msgstr "✦ Espinas: Daña el arma del atacante cuerpo a cuerpo"

msgid "✦ Swiftness: @1% Movement Speed"
msgstr "✦ Rapidez: @1% Velocidad de movimiento"

msgid "✦ High Jump: @1% Jump Height"
msgstr "✦ Salto alto: @1% Altura de salto"

msgid "✦ Gravity: @1%"
msgstr "✦ Gravedad: @1%"

msgid "★ Set Synergy (4+ Pieces): +10% Total Defense"
msgstr "★ Sinergia de conjunto (4+ piezas): +10% Defensa total"

msgid "★ Tower Shield: Counts toward matching 4-piece set bonus"
msgstr "★ Escudo torre: Cuenta para el bonus de conjunto de 4 piezas"

msgid "  Combine 4 wood pieces for early-game defense bonus."
msgstr "  Combina 4 piezas de madera para obtener un bonus defensivo inicial."

msgid "  Combine 4 cactus pieces for early-game thorny protection."
msgstr "  Combina 4 piezas de cactus para obtener protección espinosa inicial."

msgid "  Combine 4 steel pieces for solid all-around mid-game defense."
msgstr "  Combina 4 piezas de acero para una sólida defensa general."

msgid "  Combine 4 bronze pieces for heavy durable defense exceeding steel."
msgstr "  Combina 4 piezas de bronce para una defensa pesada y duradera superior al acero."

msgid "  Combine 4 diamond pieces for elite end-game damage absorption."
msgstr "  Combina 4 piezas de diamante para una absorción de daño de élite."

msgid "  Full set yields +12% (+15% w/ shield) healing ward chance!"
msgstr "  ¡El conjunto completo otorga +12% (+15% con escudo) probabilidad de guardia sanadora!"

msgid "  Combine set for high durability, healing ward & feather falling!"
msgstr "  ¡Combina el conjunto para alta durabilidad, guardia sanadora y caída de pluma!"

msgid "  Hybrid Set: Water breathing (head), fire ward (chest) & healing (shield)!"
msgstr "  ¡Conjunto híbrido: respiración acuática (cabeza), fuego (torso) y curación (escudo)!"

msgid "  Full 4+ piece set grants Tier 5 Molten & Lava Immunity!"
msgstr "  ¡El conjunto de 4+ piezas otorga inmunidad de Nivel 5 al calor y la lava!"

msgid "★ Omnipotent Set: Total immunity, infinite durability & 100% healing ward."
msgstr "★ Conjunto omnipotente: Inmunidad total, durabilidad infinita y 100% curación."

msgid "✦ Wardrobe Management & Quick Swap:"
msgstr "✦ Gestión de vestuario y cambio rápido:"

msgid "  • Live 3D character display mannequin"
msgstr "  • Maniquí de exhibición 3D del personaje en vivo"

msgid "  • Right-click: Open Stand UI with one-click Swap button"
msgstr "  • Clic derecho: Abre el menú del soporte con botón de cambio"

msgid "  • Sneak + Right-click: Instant quick-swap loadout"
msgstr "  • Agacharse + Clic derecho: Cambio rápido instantáneo del equipo"

msgid "  • Preserves item wear, enchants, and custom metadata"
msgstr "  • Conserva desgaste, encantamientos y metadatos personalizados"

