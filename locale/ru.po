msgstr "Пассивная защита: "

msgid "Damage Reduction"
msgstr "Снижение урона"

msgid "Durability: "
msgstr "Прочность: "

msgid "Unbreakable (Infinite)"
msgstr "Нерушимый (Бесконечная)"

msgid "@1 Uses"
msgstr "@1 использований"

msgid "✦ Healing Ward: +@1% Chance on hit to nullify damage & heal"
msgstr "✦ Исцеляющий щит: +@1% шанс при ударе свести урон к нулю и исцелить"

msgid "✦ Fire Ward: +1 Heat Tier (Tier 5 Molten Immunity at 4+ pieces)"
msgstr "✦ Огненный щит: +1 уровень жаростойкости (5 уровень иммунитета к лаве при 4+ предметах)"

msgid "✦ Fire Ward: +1 Heat Tier (Protects against torches & hot flora)"
msgstr "✦ Огненный щит: +1 уровень жаростойкости (Защищает от факелов и горячей флоры)"

msgid "✦ Water Ward: Underwater Breathing (Infinite Drown Immunity)"
msgstr "✦ Водный щит: Дыхание под водой (Бесконечный иммунитет к утоплению)"

msgid "✦ Feather Fall: -@1 Fall Damage (@2 Hearts Absorbed)"
msgstr "✦ Падение перышком: -@1 урон от падения (@2 сердца поглощено)"

msgid "✦ Shield Guard (Hold RMB):"
msgstr "✦ Блок щитом (Удерживайте ПКМ):"

msgid "✦ Reinforced Tower Guard (Hold RMB):"
msgstr "✦ Усиленный башенный блок (Удерживайте ПКМ):"

msgid "  • Block Mitigation: @1% damage absorbed"
msgstr "  • Смягчение блоком: @1% урона поглощено"

msgid "  • Block Mitigation: @1% damage absorbed (reinforced)"
msgstr "  • Смягчение блоком: @1% урона поглощено (усилено)"

msgid "  • Frontal Guard Arc: @1° cone (@2° off-hand bias)"
msgstr "  • Фронтальный угол блока: сектор @1° (смещение влево @2°)"

msgid "  • Projectile Deflection: Bounces arrows & fireballs"
msgstr "  • Отражение снарядов: Отбивает стрелы и огненные шары"

msgid "  • Thorns: Damages melee attacker's weapon"
msgstr "  • Шипы: Повреждает оружие атакующего в ближнем бою"

msgid "✦ Thorns: Damages melee attacker's weapon"
msgstr "✦ Шипы: Повреждает оружие атакующего в ближнем бою"

msgid "✦ Swiftness: @1% Movement Speed"
msgstr "✦ Стремительность: @1% скорость передвижения"

msgid "✦ High Jump: @1% Jump Height"
msgstr "✦ Высокий прыжок: @1% высота прыжка"

msgid "✦ Gravity: @1%"
msgstr "✦ Гравитация: @1%"

msgid "★ Set Synergy (4+ Pieces): +10% Total Defense"
msgstr "★ Синергия комплекта (4+ предмета): +10% общая защита"

msgid "★ Tower Shield: Counts toward matching 4-piece set bonus"
msgstr "★ Башенный щит: Учитывается в бонусе комплекта из 4 предметов"

msgid "  Combine 4 wood pieces for early-game defense bonus."
msgstr "  Соберите 4 деревянных предмета для начального бонуса защиты."

msgid "  Combine 4 cactus pieces for early-game thorny protection."
msgstr "  Соберите 4 кактусовых предмета для начальной шипастой защиты."

msgid "  Combine 4 steel pieces for solid all-around mid-game defense."
msgstr "  Соберите 4 стальных предмета для надежной всесторонней защиты."

msgid "  Combine 4 bronze pieces for heavy durable defense exceeding steel."
msgstr "  Соберите 4 бронзовых предмета для прочной тяжелой защиты лучше стали."

msgid "  Combine 4 diamond pieces for elite end-game damage absorption."
msgstr "  Соберите 4 алмазных предмета для максимального поглощения урона."

msgid "  Full set yields +12% (+15% w/ shield) healing ward chance!"
msgstr "  Полный комплект дает +12% (+15% со щитом) шанс на исцеляющий щит!"

msgid "  Combine set for high durability, healing ward & feather falling!"
msgstr "  Соберите комплект для высокой прочности, исцеления и мягкого падения!"

msgid "  Hybrid Set: Water breathing (head), fire ward (chest) & healing (shield)!"
msgstr "  Гибридный сет: дыхание под водой (шлем), защита от огня (торс) и лечение (щит)!"

msgid "  Full 4+ piece set grants Tier 5 Molten & Lava Immunity!"
msgstr "  Комплект из 4+ предметов дает 5 уровень иммунитета к лаве и огню!"

msgid "★ Omnipotent Set: Total immunity, infinite durability & 100% healing ward."
msgstr "★ Всемогущий комплект: Полный иммунитет, бесконечная прочность и 100% лечение."

msgid "✦ Wardrobe Management & Quick Swap:"
msgstr "✦ Управление гардеробом и быстрая смена:"

msgid "  • Live 3D character display mannequin"
msgstr "  • Живой 3D-манекен персонажа"

msgid "  • Right-click: Open Stand UI with one-click Swap button"
msgstr "  • ПКМ: Открыть меню стойки с кнопкой быстрой смены"

msgid "  • Sneak + Right-click: Instant quick-swap loadout"
msgstr "  • Присед + ПКМ: Мгновенная смена комплекта брони"

msgid "  • Preserves item wear, enchants, and custom metadata"
msgstr "  • Сохраняет износ, чары и пользовательские метаданные"

msgid "Armor Stand (Owned by @1)\nEquipped: @2"
msgstr "Стойка для брони (Владелец: @1)\nНадето: @2"

msgid "Armor Stand (Owned by @1) [Empty]"
msgstr "Стойка для брони (Владелец: @1) [Пусто]"

msgid "Armor Stand\nEquipped: @1"
msgstr "Стойка для брони\nНадето: @1"

msgid "Armor Stand [Empty]"
msgstr "Стойка для брони [Пусто]"

msgid "Tip: Right-click in hand to quick-equip or swap"
msgstr "Совет: Нажмите ПКМ в руке для быстрого надевания или замены"

msgid "Tip: Equip in shield slot; hold RMB to raise guard"
msgstr "Совет: Наденьте в слот щита; удерживайте ПКМ для блока"

msgid "Tip: Equip in shield slot; hold RMB to raise heavy guard"
msgstr "Совет: Наденьте в слот щита; удерживайте ПКМ для тяжелого блока"

msgid "Tip: Point crosshair at stand to view equipped pieces"
msgstr "Совет: Наведите прицел на стойку, чтобы увидеть надетую броню"

msgid "Helmet Slot"
msgstr "Слот шлема"

msgid "Equip a helmet or headpiece here for defense."
msgstr "Поместите сюда шлем или головной убор для защиты."

msgid "Chestplate Slot"
msgstr "Слот нагрудника"

msgid "Equip a chestplate or body armor here for core protection."
msgstr "Поместите сюда нагрудник для защиты тела."

msgid "Shield Slot"
msgstr "Слот щита"

msgid "Equip a shield here for active frontal damage blocking."
msgstr "Поместите сюда щит для активного блокирования ударов спереди."

msgid "Leggings Slot"
msgstr "Слот поножей"

msgid "Equip leggings or greaves here for lower-body defense."
msgstr "Поместите сюда поножи для защиты ног."

msgid "Boots Slot"
msgstr "Слот ботинок"

msgid "Equip boots here for foot protection and mobility."
msgstr "Поместите сюда ботинки для защиты стоп и подвижности."

msgid "Accessory Slot"
msgstr "Слот аксессуара"

msgid "Equip extra armor or an accessory here."
msgstr "Поместите сюда дополнительную броню или аксессуар."

msgid "Place a helmet or headpiece here."
msgstr "Поместите сюда шлем или головной убор."

msgid "Place a chestplate or cuirass here."
msgstr "Поместите сюда нагрудник или кирасу."

msgid "Place a shield here."
msgstr "Поместите сюда щит."

msgid "Place leggings or greaves here."
msgstr "Поместите сюда поножи."

msgid "Place boots here."
msgstr "Поместите сюда ботинки."

msgid "ARMOR STAND - @1"
msgstr "СТОЙКА ДЛЯ БРОНИ - @1"

