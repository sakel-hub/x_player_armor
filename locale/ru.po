msgstr "Сменить весь комплект брони между игроком и стойкой"

msgid "Take"
msgstr "Забрать"

msgid "Take all armor from stand into player inventory"
msgstr "Забрать всю броню со стойки в инвентарь игрока"

msgid "Cannot swap armor: @1 is cursed!"
msgstr "Невозможно сменить броню: @1 проклят(а)!"

msgid "You do not have permission to access this armor stand."
msgstr "У вас нет разрешения на доступ к этой стойке для брони."

msgid "Close"
msgstr "Закрыть"

