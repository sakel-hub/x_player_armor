msgstr "СТОЙКА ДЛЯ БРОНИ"

msgid "STAND ARMOR"
msgstr "БРОНЯ НА СТОЙКЕ"

msgid "YOUR ARMOR"
msgstr "ВАША БРОНЯ"

msgid "Swap"
msgstr "Сменить"

